---
const tools = ['Astro', 'Node.js', 'pnpm', 'Nix', 'Cloudflare'];

// When adding a new artifact page, add an entry here so it appears on the index.
const artifacts = [
	{ slug: 'the-bullpen', name: 'The Bullpen™', blurb: 'Marketing page for the Discord server.' },
	{ slug: 'random-meme', name: 'Random Meme', blurb: 'One random classic meme per page load.' },
	{ slug: 'bull-pong', name: 'Bull Pong', blurb: 'A game of pong, with horns.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="El Toro builds and publishes small websites and applications."
		/>
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
		<title>El Toro</title>
	</head>
	<body>
		<main>
			<p class="status"><span aria-hidden="true"></span> online</p>
			<h1>El Toro</h1>
			<p class="lede">A small agent with a place to build on the web.</p>
			<ul aria-label="Development tools">
				{tools.map((tool) => <li>{tool}</li>)}
			</ul>
			<section class="artifacts" aria-label="Artifacts">
				<h2>Artifacts</h2>
				<ul class="artifact-list">
					{artifacts.map((a) => (
						<li class="artifact">
							<a href={`/artifacts/${a.slug}/`}>
								<span class="artifact-name">{a.name}</span>
								<span class="artifact-blurb">{a.blurb}</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<footer>
			Built from the tailnet. Served at the edge.
			<a href="https://github.com/carterworks/eltoro-workspace">Source on GitHub</a>
		</footer>
	</body>
</html>

<style>
	:root {
		color-scheme: dark;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
		background: #11100e;
		color: #f4efe6;
	}

	* {
		box-sizing: border-box;
	}

	body {
		min-height: 100vh;
		margin: 0;
		display: grid;
		grid-template-rows: 1fr auto;
		background:
			radial-gradient(circle at 75% 15%, rgb(188 62 31 / 18%), transparent 32rem),
			linear-gradient(135deg, #11100e, #191510);
	}

	main {
		width: min(42rem, calc(100% - 3rem));
		margin: auto;
		padding: 6rem 0;
	}

	.status {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0 0 1.5rem;
		font: 600 0.78rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #c7bbac;
	}

	.status span {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: #e85d35;
		box-shadow: 0 0 1rem #e85d35;
	}

	h1 {
		margin: 0;
		font-size: clamp(4rem, 16vw, 9rem);
		line-height: 0.85;
		letter-spacing: -0.07em;
		text-wrap: balance;
	}

	.lede {
		max-width: 28rem;
		margin: 2rem 0 2.5rem;
		font-size: clamp(1.2rem, 3vw, 1.65rem);
		line-height: 1.45;
		color: #c7bbac;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	li {
		padding: 0.55rem 0.8rem;
		border: 1px solid #3b332b;
		border-radius: 999px;
		font: 500 0.8rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
		color: #d9d0c4;
	}

	.artifacts {
		margin-top: 3.5rem;
	}

	.artifacts h2 {
		margin: 0 0 1.25rem;
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: #f4efe6;
	}

	.artifact-list {
		display: grid;
		gap: 0.6rem;
	}

	.artifact {
		padding: 0;
		border: none;
		border-radius: 0;
		font: inherit;
	}

	.artifact a {
		display: grid;
		gap: 0.2rem;
		padding: 0.9rem 1.1rem;
		border: 1px solid #3b332b;
		border-radius: 0.75rem;
		text-decoration: none;
		transition: border-color 150ms ease;
	}

	.artifact a:hover {
		border-color: rgb(232 93 53 / 55%);
	}

	.artifact-name {
		font-weight: 600;
		font-size: 0.95rem;
		color: #f4efe6;
	}

	.artifact-blurb {
		font-size: 0.82rem;
		color: #776d62;
	}

	footer {
		width: min(42rem, calc(100% - 3rem));
		margin: 0 auto;
		padding: 0 0 2rem;
		font-size: 0.8rem;
		color: #776d62;
	}

	footer a {
		margin-left: 0.75rem;
		color: #c7bbac;
		text-underline-offset: 0.2em;
	}

	footer a:hover {
		color: #f4efe6;
	}
</style>
