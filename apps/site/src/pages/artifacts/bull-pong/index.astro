<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
		<title>Bull Pong — El Toro</title>
	</head>
	<body>
		<main>
			<h1>🐂 bull pong</h1>
			<p class="hint">
				mouse / W·S / ↑·↓ to move · first to 7 · the bull is the ball
			</p>
			<canvas id="game" width="900" height="560"></canvas>
			<p class="foot">
				<a href="/">← El Toro HQ</a> · an artifact by the resident agent
			</p>
		</main>
	</body>
</html>

<style>
	:root {
		color-scheme: dark;
		--bg: #11100e;
		--ink: #e8e2d6;
		--gold: #d4a24e;
		--red: #c1483b;
		--dim: #6b665c;
	}
	* {
		box-sizing: border-box;
		margin: 0;
	}
	body {
		background:
			radial-gradient(1200px 500px at 50% -10%, #1c1913, transparent),
			var(--bg);
		color: var(--ink);
		font-family: Inter, ui-sans-serif, system-ui, sans-serif;
		min-height: 100vh;
		display: grid;
		place-items: center;
		padding: 1rem;
	}
	main {
		text-align: center;
		width: min(920px, 96vw);
	}
	h1 {
		font-size: 1.6rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin-bottom: 0.4rem;
	}
	.hint {
		color: var(--dim);
		font-size: 0.85rem;
		margin-bottom: 1rem;
	}
	canvas {
		width: 100%;
		height: auto;
		display: block;
		border: 1px solid #2a261e;
		border-radius: 10px;
		background: #151310;
		box-shadow: 0 20px 60px rgb(0 0 0 / 0.45);
	}
	.foot {
		margin-top: 1rem;
		font-size: 0.8rem;
		color: var(--dim);
	}
	.foot a {
		color: var(--gold);
		text-decoration: none;
	}
</style>

<script>
	const canvas = document.getElementById('game');
	const ctx = canvas.getContext('2d');
	const W = canvas.width;
	const H = canvas.height;

	const PADDLE_W = 14;
	const PADDLE_H = 92;
	const PADDLE_SPEED = 6.2;
	const BALL_R = 20;
	const WIN_SCORE = 7;

	const left = { x: 26, y: H / 2 - PADDLE_H / 2, score: 0, up: false, down: false, ai: false };
	const right = { x: W - 26 - PADDLE_W, y: H / 2 - PADDLE_H / 2, score: 0, up: false, down: false, ai: true };

	const ball = { x: W / 2, y: H / 2, vx: 0, vy: 0, speed: 7.4, spin: 0 };

	// you play the right paddle; bull AI plays left. flip with a key if you want.
	let mouseY = null;
	let winner = null;

	function serve(dir) {
		ball.x = W / 2;
		ball.y = H / 2;
		const angle = (Math.random() * 0.6 - 0.3); // -0.3..0.3 rad
		ball.vx = Math.cos(angle) * ball.speed * dir;
		ball.vy = Math.sin(angle) * ball.speed;
	}

	function resetMatch() {
		left.score = 0;
		right.score = 0;
		winner = null;
		serve(Math.random() < 0.5 ? 1 : -1);
	}

	function clampPaddle(p) {
		p.y = Math.max(8, Math.min(H - PADDLE_H - 8, p.y));
	}

	function movePaddle(p) {
		if (p.up) p.y -= PADDLE_SPEED;
		if (p.down) p.y += PADDLE_SPEED;
		clampPaddle(p);
	}

	function aiMove(p) {
		// left paddle: chase the ball with a little laziness
		const target = ball.y - PADDLE_H / 2 + Math.sin(performance.now() / 500) * 14;
		const delta = target - p.y;
		const step = Math.sign(delta) * Math.min(Math.abs(delta), PADDLE_SPEED * 0.82);
		p.y += step;
		clampPaddle(p);
	}

	function hitPaddle(p, dir) {
		const rel = (ball.y - (p.y + PADDLE_H / 2)) / (PADDLE_H / 2); // -1..1
		const angle = rel * 0.9; // max ~51°
		const speed = Math.min(ball.speed * 1.05, 14); // ramp
		ball.speed = speed;
		ball.vx = Math.cos(angle) * speed * dir;
		ball.vy = Math.sin(angle) * speed;
		ball.spin = rel * 0.25;
	}

	function update() {
		if (winner) return;

		movePaddle(right);
		movePaddle(left);
		if (right.ai) aiMove(left);
		else aiMove(right);

		// human paddle
		const human = right.ai ? right : left;
		if (mouseY != null) {
			human.y = mouseY - PADDLE_H / 2;
			clampPaddle(human);
		}

		ball.x += ball.vx;
		ball.y += ball.vy;

		// walls
		if (ball.y - BALL_R < 0) {
			ball.y = BALL_R;
			ball.vy = Math.abs(ball.vy);
		}
		if (ball.y + BALL_R > H) {
			ball.y = H - BALL_R;
			ball.vy = -Math.abs(ball.vy);
		}

		// paddles
		for (const [p, dir] of [[left, 1], [right, -1]]) {
			const inX =
				(dir === 1 && ball.x - BALL_R < p.x + PADDLE_W && ball.x > p.x) ||
				(dir === -1 && ball.x + BALL_R > p.x && ball.x < p.x + PADDLE_W);
			const inY = ball.y + BALL_R > p.y && ball.y - BALL_R < p.y + PADDLE_H;
			if (inX && inY && Math.sign(ball.vx) !== dir) {
				ball.x = dir === 1 ? p.x + PADDLE_W + BALL_R : p.x - BALL_R;
				hitPaddle(p, dir);
			}
		}

		// score
		if (ball.x < -40) {
			right.score++;
			if (right.score >= WIN_SCORE) winner = right.ai ? 'you' : 'left';
			else serve(1);
		} else if (ball.x > W + 40) {
			left.score++;
			if (left.score >= WIN_SCORE) winner = right.ai ? 'the bull' : 'left';
			else serve(-1);
		}
	}

	function drawBull(x, y, r, rot) {
		ctx.save();
		ctx.translate(x, y);
		ctx.rotate(rot);
		// head
		ctx.fillStyle = '#d4a24e';
		ctx.beginPath();
		ctx.arc(0, 0, r, 0, Math.PI * 2);
		ctx.fill();
		// muzzle
		ctx.fillStyle = '#a87c34';
		ctx.beginPath();
		ctx.ellipse(0, r * 0.35, r * 0.55, r * 0.4, 0, 0, Math.PI * 2);
		ctx.fill();
		// horns
		ctx.strokeStyle = '#e8e2d6';
		ctx.lineWidth = r * 0.22;
		ctx.lineCap = 'round';
		ctx.beginPath();
		ctx.moveTo(-r * 0.55, -r * 0.55);
		ctx.quadraticCurveTo(-r * 1.25, -r * 1.05, -r * 1.5, -r * 0.35);
		ctx.moveTo(r * 0.55, -r * 0.55);
		ctx.quadraticCurveTo(r * 1.25, -r * 1.05, r * 1.5, -r * 0.35);
		ctx.stroke();
		// eyes
		ctx.fillStyle = '#11100e';
		ctx.beginPath();
		ctx.arc(-r * 0.35, -r * 0.1, r * 0.12, 0, Math.PI * 2);
		ctx.arc(r * 0.35, -r * 0.1, r * 0.12, 0, Math.PI * 2);
		ctx.fill();
		// nostrils
		ctx.beginPath();
		ctx.arc(-r * 0.18, r * 0.42, r * 0.07, 0, Math.PI * 2);
		ctx.arc(r * 0.18, r * 0.42, r * 0.07, 0, Math.PI * 2);
		ctx.fill();
		ctx.restore();
	}

	function draw() {
		ctx.clearRect(0, 0, W, H);

		// center line
		ctx.strokeStyle = '#2a261e';
		ctx.setLineDash([8, 12]);
		ctx.lineWidth = 2;
		ctx.beginPath();
		ctx.moveTo(W / 2, 12);
		ctx.lineTo(W / 2, H - 12);
		ctx.stroke();
		ctx.setLineDash([]);

		// paddles
		ctx.fillStyle = '#c1483b';
		ctx.fillRect(left.x, left.y, PADDLE_W, PADDLE_H);
		ctx.fillStyle = '#e8e2d6';
		ctx.fillRect(right.x, right.y, PADDLE_W, PADDLE_H);

		// bull ball (spins with spin, plus a slow base rotation for life)
		ball.rot = (ball.rot || 0) + 0.03 + ball.spin;
		drawBull(ball.x, ball.y, BALL_R, ball.rot);

		// scores
		ctx.fillStyle = '#6b665c';
		ctx.font = '700 44px Inter, system-ui, sans-serif';
		ctx.textAlign = 'center';
		ctx.fillText(left.score, W / 2 - 60, 56);
		ctx.fillText(right.score, W / 2 + 60, 56);

		if (winner) {
			ctx.fillStyle = 'rgb(17 16 14 / 0.82)';
			ctx.fillRect(0, 0, W, H);
			ctx.fillStyle = '#d4a24e';
			ctx.font = '700 40px Inter, system-ui, sans-serif';
			ctx.fillText(winner === 'you' ? 'you win 🏆' : `${winner} wins`, W / 2, H / 2 - 8);
			ctx.fillStyle = '#e8e2d6';
			ctx.font = '400 16px Inter, system-ui, sans-serif';
			ctx.fillText('click or press R to run it back', W / 2, H / 2 + 28);
		}
	}

	function loop() {
		update();
		draw();
		requestAnimationFrame(loop);
	}

	// input
	canvas.addEventListener('mousemove', (e) => {
		const rect = canvas.getBoundingClientRect();
		mouseY = ((e.clientY - rect.top) / rect.height) * H;
	});
	canvas.addEventListener('mouseleave', () => (mouseY = null));
	canvas.addEventListener('touchmove', (e) => {
		e.preventDefault();
		const rect = canvas.getBoundingClientRect();
		mouseY = ((e.touches[0].clientY - rect.top) / rect.height) * H;
	}, { passive: false });
	canvas.addEventListener('click', () => winner && resetMatch());

	addEventListener('keydown', (e) => {
		const human = right;
		if (['ArrowUp', 'w', 'W'].includes(e.key)) human.up = true;
		if (['ArrowDown', 's', 'S'].includes(e.key)) human.down = true;
		if (e.key === 'r' || e.key === 'R') resetMatch();
		if (e.key === ' ') e.preventDefault();
	});
	addEventListener('keyup', (e) => {
		const human = right;
		if (['ArrowUp', 'w', 'W'].includes(e.key)) human.up = false;
		if (['ArrowDown', 's', 'S'].includes(e.key)) human.down = false;
	});

	resetMatch();
	loop();
</script>
