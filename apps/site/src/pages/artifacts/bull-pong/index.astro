---
import ElToroLogo from '../../../components/ElToroLogo.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
		<title>Bull Pong — El Toro</title>
	</head>
	<body>
		<main>
			<ElToroLogo size={64} class="pong-logo" />
			<h1>🐂 bull pong</h1>
			<p class="hint">
				mouse / W·S / ↑·↓ to move · first to 7 · the bull is the ball<br />
				the bull plays the empty paddle — land here and you take it, mid-rally
			</p>
			<p class="net" id="net" role="status" aria-live="polite">warming up the pen…</p>
			<canvas id="game" width="900" height="560"></canvas>
			<p class="foot">
				<a href="/">← El Toro HQ</a> · an artifact by the resident agent · netplay via the
				<a href="https://github.com/yjs/y-websocket">y-websocket</a> relay
			</p>
		</main>
	</body>
</html>

<style>
	:root {
		color-scheme: dark;
		--bg: #11100e;
		--ink: #e8e2d6;
		--gold: #d4a24e;
		--red: #c1483b;
		--dim: #6b665c;
	}
	* {
		box-sizing: border-box;
		margin: 0;
	}
	body {
		background:
			radial-gradient(1200px 500px at 50% -10%, #1c1913, transparent),
			var(--bg);
		color: var(--ink);
		font-family: Inter, ui-sans-serif, system-ui, sans-serif;
		min-height: 100vh;
		display: grid;
		place-items: center;
		padding: 1rem;
	}
	main {
		text-align: center;
		width: min(920px, 96vw);
	}
	.pong-logo {
		margin: 0 auto 1.25rem;
	}
	h1 {
		font-size: 1.6rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin-bottom: 0.4rem;
	}
	.hint {
		color: var(--dim);
		font-size: 0.85rem;
		line-height: 1.5;
		margin-bottom: 0.9rem;
	}
	.net {
		min-height: 1.2rem;
		font: 500 0.78rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
		color: var(--dim);
		margin-bottom: 0.55rem;
		overflow-wrap: anywhere;
	}
	.net[data-kind='good'] {
		color: var(--gold);
	}
	.net[data-kind='bad'] {
		color: var(--red);
	}
	canvas {
		width: 100%;
		height: auto;
		display: block;
		border: 1px solid #2a261e;
		border-radius: 10px;
		background: #151310;
		box-shadow: 0 20px 60px rgb(0 0 0 / 0.45);
		cursor: none;
	}
	.foot {
		margin-top: 1rem;
		font-size: 0.8rem;
		color: var(--dim);
	}
	.foot a {
		color: var(--gold);
		text-decoration: none;
	}
</style>

<script>
	import * as Y from 'yjs';
	import { WebsocketProvider } from 'y-websocket';
	import {
		W,
		H,
		PEN,
		PADDLE_W,
		BASE_PADDLE_H,
		BALL_R,
		PADDLE_SPEED,
		FRAME_MS,
		createState,
		resetMatch,
		step,
		serialize,
		deserialize,
		toast,
	} from '../../../lib/bull-pong/engine.js';
	import {
		RELAY_URL,
		PEN_SLOTS,
		penRoom,
		penLabel,
		penPrefixFromUrl,
		otherSide,
		classifySlot,
		pickSlot,
		resolvePen,
		acceptSnapshot,
		describePen,
	} from '../../../lib/bull-pong/netcode.js';

	const canvas = document.getElementById('game');
	const ctx = canvas.getContext('2d');
	const netEl = document.getElementById('net');

	const bullImg = new Image();
	bullImg.src = '/artifacts/bull-pong/bull-ball.png';

	const penPrefix = penPrefixFromUrl(location.href);

	// ---------------------------------------------------------------- state ----

	const game = createState((Math.random() * 1e9) | 0); // local simulation
	let view = game; // what the renderer draws
	let target = null; // player: latest authority snapshot
	let snapAt = 0; // player: when that snapshot landed

	let authority = true; // do we simulate the match?
	let localSide = 'right'; // the paddle this client drives
	let botSide = 'left'; // the paddle the bull plays (null when two humans)
	let networked = false;
	let penIndex = null;
	let scanning = false;
	let link = null; // { doc, provider, awareness }
	let picture = null;
	let otherStale = false; // the other human went quiet
	let lastOtherSignal = 0;
	let lastAuthoritySignal = 0;
	let unseatedSince = 0;
	let localY = H / 2;
	let seenSeq = -1;
	let resetCounter = 0;
	let lastResetReq = 0;
	let lastSent = 0;
	let lastSnapshot = 0;
	let acc = 0;
	let lastFrame = 0;
	let retryTimer = null;

	function statusOf() {
		return describePen({ networked, scanning, penIndex, picture, localSide, authority });
	}

	function refreshStatus(kind) {
		setStatus(statusOf(), kind ?? (networked && picture?.seated ? 'good' : ''));
	}

	function setStatus(text, kind = '') {
		netEl.textContent = text;
		if (kind) netEl.dataset.kind = kind;
		else delete netEl.dataset.kind;
	}

	// ------------------------------------------------------------------ draw ----

	function drawBull(x, y, r, rot) {
		ctx.save();
		ctx.translate(x, y);
		ctx.rotate(rot);
		if (bullImg.complete && bullImg.naturalWidth) {
			const s = r * 2.35; // sprite has transparent padding; draw a touch larger
			ctx.drawImage(bullImg, -s / 2, -s / 2, s, s);
		} else {
			ctx.fillStyle = '#d4a24e';
			ctx.beginPath();
			ctx.arc(0, 0, r, 0, Math.PI * 2);
			ctx.fill();
		}
		ctx.restore();
	}

	function drawHUD(s, now) {
		ctx.font = '600 11px ui-monospace, SFMono-Regular, Menlo, monospace';
		ctx.textBaseline = 'top';
		for (const [key, x, align] of [
			['left', 24, 'left'],
			['right', W - 24, 'right'],
		]) {
			const sd = s.side[key];
			const parts = [];
			if (now < sd.wideUntil) parts.push(`♉ ${((sd.wideUntil - now) / 1000).toFixed(0)}s`);
			if (sd.fence) parts.push('🚧');
			if (parts.length) {
				ctx.textAlign = align;
				ctx.fillStyle = '#d4a24e';
				ctx.fillText(parts.join('  '), x, 18);
			}
		}
		const mood = [];
		if (now < s.fx.slowUntil) mood.push(`❄ ${((s.fx.slowUntil - now) / 1000).toFixed(0)}s`);
		if (now < s.fx.rageUntil) mood.push(`🔥 ${((s.fx.rageUntil - now) / 1000).toFixed(0)}s`);
		if (mood.length) {
			ctx.textAlign = 'center';
			ctx.fillStyle = '#6b665c';
			ctx.fillText(mood.join('  '), W / 2, 74);
		}
		ctx.textBaseline = 'alphabetic';
	}

	function drawToasts(s, now) {
		ctx.textAlign = 'center';
		ctx.font = '600 13px ui-monospace, SFMono-Regular, Menlo, monospace';
		let i = 0;
		for (const t of s.toasts) {
			const age = (now - t.t0) / 1400;
			if (age >= 1) continue;
			ctx.globalAlpha = 1 - age;
			ctx.fillStyle = t.color;
			ctx.fillText(t.text, W / 2, H * 0.3 + i * 20 - age * 12);
			i++;
		}
		ctx.globalAlpha = 1;
	}

	function whoIs(side) {
		if (side === localSide) return 'YOU';
		if (side === botSide) return 'BOT';
		return authority ? 'THEY' : 'HOST';
	}

	function draw() {
		const s = view;
		const now = s.now;
		ctx.clearRect(0, 0, W, H);

		ctx.strokeStyle = '#2a261e';
		ctx.setLineDash([8, 12]);
		ctx.lineWidth = 2;
		ctx.beginPath();
		ctx.moveTo(W / 2, 12);
		ctx.lineTo(W / 2, H - 12);
		ctx.stroke();
		ctx.setLineDash([]);

		const RAIL = '#8a6a42';
		const RAIL_HI = '#b89363';
		ctx.lineCap = 'butt';
		for (const y of [6, 16, H - 16, H - 6]) {
			ctx.strokeStyle = RAIL;
			ctx.lineWidth = 4;
			ctx.beginPath();
			ctx.moveTo(0, y);
			ctx.lineTo(W, y);
			ctx.stroke();
			ctx.strokeStyle = RAIL_HI;
			ctx.lineWidth = 1;
			ctx.beginPath();
			ctx.moveTo(0, y - 1.5);
			ctx.lineTo(W, y - 1.5);
			ctx.stroke();
		}
		for (const x of [6, 16, W - 16, W - 6]) {
			ctx.strokeStyle = RAIL;
			ctx.lineWidth = 4;
			ctx.beginPath();
			ctx.moveTo(x, 0);
			ctx.lineTo(x, H);
			ctx.stroke();
			ctx.strokeStyle = RAIL_HI;
			ctx.lineWidth = 1;
			ctx.beginPath();
			ctx.moveTo(x - 1.5, 0);
			ctx.lineTo(x - 1.5, H);
			ctx.stroke();
		}
		ctx.fillStyle = '#6e5433';
		for (const x of [6, W / 2, W - 6]) for (const y of [6, H - 6]) ctx.fillRect(x - 3, y - 3, 6, 6);
		for (const x of [6, 16, W - 16, W - 6])
			for (const y of [H / 4, H / 2, (H * 3) / 4]) ctx.fillRect(x - 3, y - 3, 6, 6);

		for (const [key, x] of [
			['left', 24],
			['right', W - 24],
		]) {
			if (s.side[key].fence) {
				ctx.strokeStyle = '#e8c547';
				ctx.globalAlpha = 0.65 + Math.sin(now / 200) * 0.2;
				ctx.setLineDash([6, 8]);
				ctx.lineWidth = 3;
				ctx.beginPath();
				ctx.moveTo(x, 8);
				ctx.lineTo(x, H - 8);
				ctx.stroke();
				ctx.setLineDash([]);
				ctx.globalAlpha = 1;
			}
		}

		ctx.fillStyle = '#c1483b';
		if (s.left.h > BASE_PADDLE_H) {
			ctx.shadowColor = '#d4a24e';
			ctx.shadowBlur = 14;
		}
		ctx.fillRect(s.left.x, s.left.y, PADDLE_W, s.left.h);
		ctx.shadowBlur = 0;
		ctx.fillStyle = '#e8e2d6';
		if (s.right.h > BASE_PADDLE_H) {
			ctx.shadowColor = '#d4a24e';
			ctx.shadowBlur = 14;
		}
		ctx.fillRect(s.right.x, s.right.y, PADDLE_W, s.right.h);
		ctx.shadowBlur = 0;

		for (const p of s.powerups) {
			const pulse = 1 + Math.sin(now / 280 + p.x) * 0.08;
			ctx.save();
			ctx.globalAlpha = 0.9;
			ctx.fillStyle = '#151310';
			ctx.strokeStyle = p.color;
			ctx.lineWidth = 2;
			ctx.beginPath();
			ctx.arc(p.x, p.y, p.r * pulse, 0, Math.PI * 2);
			ctx.fill();
			ctx.stroke();
			ctx.font = '15px serif';
			ctx.textAlign = 'center';
			ctx.textBaseline = 'middle';
			ctx.fillStyle = p.color;
			ctx.fillText(p.glyph, p.x, p.y + 1);
			ctx.font = '600 7px ui-monospace, monospace';
			ctx.fillStyle = '#776d62';
			ctx.fillText(p.label, p.x, p.y + p.r + 10);
			ctx.restore();
		}

		for (const b of s.balls) drawBull(b.x, b.y, BALL_R, b.rot);

		ctx.fillStyle = '#6b665c';
		ctx.font = '700 44px Inter, system-ui, sans-serif';
		ctx.textAlign = 'center';
		ctx.fillText(s.left.score, W / 2 - 60, 56);
		ctx.fillText(s.right.score, W / 2 + 60, 56);

		drawHUD(s, now);
		drawToasts(s, now);

		ctx.font = '600 10px ui-monospace, SFMono-Regular, Menlo, monospace';
		ctx.fillStyle = '#6e5433';
		ctx.textAlign = 'left';
		ctx.fillText(whoIs('left'), 24, H - 12);
		ctx.textAlign = 'right';
		ctx.fillText(whoIs('right'), W - 24, H - 12);

		if (s.winner) {
			ctx.fillStyle = 'rgb(17 16 14 / 0.82)';
			ctx.fillRect(0, 0, W, H);
			ctx.fillStyle = '#d4a24e';
			ctx.font = '700 40px Inter, system-ui, sans-serif';
			ctx.textAlign = 'center';
			const won = s.winner === localSide;
			ctx.fillText(won ? 'you win 🏆' : `${whoIs(s.winner)} wins`, W / 2, H / 2 - 8);
			ctx.fillStyle = '#e8e2d6';
			ctx.font = '400 16px Inter, system-ui, sans-serif';
			ctx.fillText('click or press R to run it back', W / 2, H / 2 + 28);
		}
	}

	// -------------------------------------------------------------- netplay ----

	function teardownLink() {
		if (retryTimer) clearTimeout(retryTimer);
		retryTimer = null;
		if (!link) return;
		try {
			link.provider.destroy();
			link.doc.destroy();
		} catch {
			/* already gone */
		}
		link = null;
		picture = null;
	}

	function closeState() {
		if (link?.provider?.awareness) {
			try {
				link.provider.awareness.setLocalState(null);
			} catch {
				/* already gone */
			}
		}
	}

	/** Leave the pen and go back to a private match against the bull. */
	function leavePen() {
		closeState();
		teardownLink();
		networked = false;
		penIndex = null;
		scanning = false;
		authority = true;
		localSide = 'right';
		botSide = 'left';
		otherStale = false;
		target = null;
		seenSeq = -1;
		localY = H / 2;
		resetMatch(game);
		view = game;
		refreshStatus();
	}

	/** Occupied the chosen pen: publish our seats and start syncing. */
	function settle(index, action, classify) {
		teardownLink();
		const role = action === 'join' ? 'guest' : 'host';
		const side = action === 'empty' ? 'right' : classify.freeSide;
		const doc = new Y.Doc();
		const provider = new WebsocketProvider(RELAY_URL, penRoom(penPrefix, index), doc, { connect: true });
		link = { doc, provider, awareness: provider.awareness };
		networked = true;
		scanning = false;
		penIndex = index;
		authority = role === 'host';
		localSide = side;
		botSide = authority ? otherSide(side) : null;
		otherStale = false;
		lastOtherSignal = performance.now();
		lastAuthoritySignal = performance.now();
		target = null;
		seenSeq = -1;
		localY = H / 2;
		provider.awareness.setLocalState({ r: role, side });
		provider.on('status', () => syncPen());
		provider.on('connection-error', () => {
			setStatus('the relay is unreachable — playing the bull meanwhile', 'bad');
		});
		provider.awareness.on('change', syncPen);
		provider.awareness.on('update', (changes) => {
			const now = performance.now();
			const touched = [...(changes?.added ?? []), ...(changes?.updated ?? [])];
			if (picture?.otherId != null && touched.includes(picture.otherId)) lastOtherSignal = now;
			if (picture?.authorityId != null && touched.includes(picture.authorityId)) lastAuthoritySignal = now;
			syncPen();
		});
		refreshStatus();
	}

	/** Re-read the pen and react: seating, promotion, abandonment. */
	function syncPen() {
		if (!link) return;
		const states = link.awareness.getStates();
		picture = resolvePen(states, link.awareness.clientID);
		const now = performance.now();

		if (!picture.seated) {
			// a race for the last paddle: back off and look for another pen
			if (!unseatedSince) unseatedSince = now;
			else if (now - unseatedSince > 2500) {
				unseatedSince = 0;
				leavePen();
				scheduleScan(500);
			}
			return;
		}
		unseatedSince = 0;

		// an older client may have claimed our side first: adopt what it decided
		if (picture.selfSide && picture.selfSide !== localSide) {
			localSide = picture.selfSide;
			if (authority) botSide = picture.botSide ?? otherSide(localSide);
			if (link?.awareness) link.awareness.setLocalStateField('side', localSide);
		}

		// the authority drives whichever paddle has no human on it, and follows
		// the other human's paddle when there is one
		if (authority) {
			const otherState = picture.otherId != null ? states.get(picture.otherId) : null;
			if (!otherStale && picture.otherSide) {
				const otherY = Number(otherState?.i?.y);
				if (Number.isFinite(otherY)) {
					game[picture.otherSide].touchY = Math.max(PEN, Math.min(H - PEN, otherY));
				}
			}
			const asked = Number(otherState?.q) || 0;
			if (asked > lastResetReq) {
				lastResetReq = asked;
				resetMatch(game);
				toast(game, '🔄 REMATCH', '#d4a24e');
				publish(true);
			}
			botSide = otherStale ? otherSide(localSide) : picture.botSide;
			if (botSide === null && picture.otherId == null) botSide = otherSide(localSide);
		} else {
			// player: render whatever the authority is serving
			const hostState = picture.authorityId != null ? states.get(picture.authorityId) : null;
			if (acceptSnapshot(hostState, 'guest', seenSeq)) applySnapshot(hostState.s);

			// the authority went quiet: take the match over, keeping our paddle
			if (!picture.hasAuthority && now - lastAuthoritySignal > 4000) {
				authority = true;
				botSide = picture.botSide ?? otherSide(localSide);
				lastOtherSignal = now;
				toast(game, '🏁 THE BULL IS YOURS NOW', '#d4a24e');
				if (link?.awareness) link.awareness.setLocalStateField('r', 'host');
			}
		}

		refreshStatus();
	}

	function scheduleScan(delay = 12000) {
		if (retryTimer) clearTimeout(retryTimer);
		retryTimer = setTimeout(() => {
			retryTimer = null;
			scanPens();
		}, delay + Math.random() * 4000);
	}

	/** Sniff every pen in parallel, then take the best seat going. */
	async function scanPens() {
		if (networked) return;
		scanning = true;
		refreshStatus();

		const probes = Array.from({ length: PEN_SLOTS }, (_, index) => probePen(index));
		const results = await Promise.all(probes);
		if (networked) return; // someone settled us while probing

		const choice = pickSlot(results.filter((r) => r));
		scanning = false;
		if (choice) {
			settle(choice.index, choice.action, choice.classify);
			return;
		}
		refreshStatus();
		scheduleScan(15000); // every pen is full — keep playing, try again soon
	}

	function probePen(index) {
		return new Promise((resolve) => {
			const doc = new Y.Doc();
			const provider = new WebsocketProvider(RELAY_URL, penRoom(penPrefix, index), doc, { connect: true });
			let settled = false;
			const finish = () => {
				if (settled) return;
				settled = true;
				let classify = { kind: 'empty', freeSide: 'right', incumbent: null };
				try {
					classify = classifySlot(provider.awareness.getStates());
				} catch {
					/* treat as empty */
				}
				try {
					provider.destroy();
					doc.destroy();
				} catch {
					/* already gone */
				}
				resolve({ index, classify });
			};
			provider.on('sync', () => setTimeout(finish, 300));
			provider.on('status', (e) => {
				if (e.status === 'connected') setTimeout(finish, 600);
			});
			setTimeout(finish, 1500);
		});
	}

	function applySnapshot(snap) {
		const now = performance.now();
		const next = deserialize(snap, now);
		if (!target || target.balls.length !== next.balls.length) view = next;
		target = next;
		snapAt = now;
		lastAuthoritySignal = now;
		view.now = now;
		view.left.score = next.left.score;
		view.right.score = next.right.score;
		view.left.h = next.left.h;
		view.right.h = next.right.h;
		view.powerups = next.powerups;
		view.fx = next.fx;
		view.side = next.side;
		view.toasts = next.toasts;
		view.winner = next.winner;
		for (const side of ['left', 'right']) {
			if (side !== localSide) view[side].y = next[side].y;
		}
		view.balls = view.balls.length === next.balls.length ? view.balls : next.balls;
		view.balls.forEach((b, i) => {
			b.rot = next.balls[i].rot;
			b.extra = next.balls[i].extra;
		});
		seenSeq = snap.n ?? seenSeq;
	}

	function publish(force = false) {
		if (!link || !authority) return;
		const now = performance.now();
		if (!force && now - lastSnapshot < 40) return;
		lastSnapshot = now;
		link.awareness.setLocalStateField('s', serialize(game));
	}

	function publishInput() {
		if (!link || authority) return;
		const now = performance.now();
		if (now - lastSent < 33) return;
		lastSent = now;
		link.awareness.setLocalStateField('i', { y: Math.round(localY) });
	}

	function requestRematch() {
		if (authority) {
			resetMatch(game);
			publish(true);
			toast(game, '🔄 REMATCH', '#d4a24e');
		} else if (link) {
			resetCounter++;
			link.awareness.setLocalStateField('q', resetCounter);
		}
	}

	// ------------------------------------------------------------------ loop ----

	function stepAndSend(now) {
		const dt = lastFrame ? now - lastFrame : FRAME_MS;

		if (!authority) {
			// player: render relayed snapshots, predict our own paddle, report it
			if (target) {
				view.now = now;
				const elapsedFrames = Math.min(now - snapAt, 200) / FRAME_MS;
				view.balls.forEach((b, i) => {
					const t = target.balls[i];
					if (!t) return;
					b.x += (t.x + t.vx * elapsedFrames - b.x) * 0.5;
					b.y += (t.y + t.vy * elapsedFrames - b.y) * 0.5;
				});
				for (const side of ['left', 'right']) {
					if (side !== localSide) view[side].y += (target[side].y - view[side].y) * 0.5;
				}
			}
			view[localSide].y = Math.max(PEN, Math.min(H - view[localSide].h - PEN, localY - view[localSide].h / 2));
			publishInput();
			return;
		}

		acc = Math.min(acc + dt, 200);
		let n = 0;
		while (acc >= FRAME_MS && n < 6) {
			step(game, { ai: botSide ?? 'none' });
			acc -= FRAME_MS;
			n++;
		}
		view = game;
		if (networked) publish();
	}

	function loop(now) {
		stepAndSend(now);
		draw();
		lastFrame = now;
		requestAnimationFrame(loop);
	}

	// ----------------------------------------------------------------- input ----

	function pointerY(clientY) {
		const rect = canvas.getBoundingClientRect();
		return ((clientY - rect.top) / rect.height) * H;
	}

	function aimLocal(y) {
		localY = Math.max(PEN, Math.min(H - PEN, y));
		if (authority) game[localSide].touchY = localY;
	}

	canvas.addEventListener('mousemove', (e) => aimLocal(pointerY(e.clientY)));
	canvas.addEventListener(
		'touchmove',
		(e) => {
			e.preventDefault();
			aimLocal(pointerY(e.touches[0].clientY));
		},
		{ passive: false },
	);
	canvas.addEventListener('click', () => {
		if (view.winner) requestRematch();
	});

	addEventListener('keydown', (e) => {
		const key = e.key.toLowerCase();
		if (key === 'arrowup' || key === 'w') {
			aimLocal(localY - PADDLE_SPEED);
			e.preventDefault();
		}
		if (key === 'arrowdown' || key === 's') {
			aimLocal(localY + PADDLE_SPEED);
			e.preventDefault();
		}
		if (key === 'r') requestRematch();
		if (e.key === ' ') e.preventDefault();
	});

	addEventListener('beforeunload', () => {
		closeState();
		teardownLink();
	});

	// -------------------------------------------------------------- watchdogs ----

	// A player who stops talking for 4s has gone: the awareness protocol's own
	// timeout is 30s, far too long to hold a paddle mid-rally.
	setInterval(() => {
		const now = performance.now();
		if (!link) return;
		if (authority && picture?.otherId != null && now - lastOtherSignal > 4000) {
			otherStale = true;
			if (picture.otherSide) game[picture.otherSide].touchY = null;
			if (botSide == null) botSide = otherSide(localSide);
			toast(game, '🚪 THEY LEFT — THE BULL TAKES OVER', '#d4a24e');
			refreshStatus();
		} else if (authority && otherStale && picture?.otherId == null) {
			otherStale = false;
		}
		if (!authority) {
			// a player's own authority vanished: syncPen promotes us after 4s
			if (picture && !picture.hasAuthority) syncPen();
		}
	}, 1000);

	// If we are stuck without a pen (every pen full, or the relay hiccuped),
	// keep sniffing — the game never stops being playable in the meantime.
	setInterval(() => {
		if (!networked) scheduleScan(2000);
	}, 20000);

	// -------------------------------------------------------------- debug hook ----

	window.__bullpong = {
		get authority() {
			return authority;
		},
		get localSide() {
			return localSide;
		},
		get botSide() {
			return botSide;
		},
		get networked() {
			return networked;
		},
		get scanning() {
			return scanning;
		},
		get pen() {
			return penIndex == null ? null : penIndex + 1;
		},
		get penPrefix() {
			return penPrefix;
		},
		get peers() {
			return link ? link.awareness.getStates().size : 0;
		},
		get seated() {
			return !!picture?.seated;
		},
		get peerStates() {
			return link
				? [...link.awareness.getStates()].map(([id, s]) => ({ id, r: s?.r, side: s?.side, hasSnapshot: !!s?.s, input: s?.i }))
				: [];
		},
		get status() {
			return netEl.textContent;
		},
		get snapshot() {
			return {
				left: { y: view.left.y, h: view.left.h, score: view.left.score },
				right: { y: view.right.y, h: view.right.h, score: view.right.score },
				balls: view.balls.map((b) => ({ x: Math.round(b.x), y: Math.round(b.y) })),
				winner: view.winner,
			};
		},
		get seq() {
			return seenSeq;
		},
		scan: () => scanPens(),
		leave: () => leavePen(),
	};

	// --------------------------------------------------------------- start up ----

	resetMatch(game);
	localY = H / 2;
	setStatus(statusOf());
	requestAnimationFrame(loop);
	scanPens();
</script>
