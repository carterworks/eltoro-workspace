<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
		<title>Bull Pong — El Toro</title>
	</head>
	<body>
		<main>
			<h1>🐂 bull pong</h1>
			<p class="hint">
				mouse / W·S / ↑·↓ to move · first to 7 · the bull is the ball<br />
				powerups drop mid-field — the bull collects them for whoever touched it last
			</p>
			<canvas id="game" width="900" height="560"></canvas>
			<p class="foot">
				<a href="/">← El Toro HQ</a> · an artifact by the resident agent
			</p>
		</main>
	</body>
</html>

<style>
	:root {
		color-scheme: dark;
		--bg: #11100e;
		--ink: #e8e2d6;
		--gold: #d4a24e;
		--red: #c1483b;
		--dim: #6b665c;
	}
	* {
		box-sizing: border-box;
		margin: 0;
	}
	body {
		background:
			radial-gradient(1200px 500px at 50% -10%, #1c1913, transparent),
			var(--bg);
		color: var(--ink);
		font-family: Inter, ui-sans-serif, system-ui, sans-serif;
		min-height: 100vh;
		display: grid;
		place-items: center;
		padding: 1rem;
	}
	main {
		text-align: center;
		width: min(920px, 96vw);
	}
	h1 {
		font-size: 1.6rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin-bottom: 0.4rem;
	}
	.hint {
		color: var(--dim);
		font-size: 0.85rem;
		line-height: 1.5;
		margin-bottom: 1rem;
	}
	canvas {
		width: 100%;
		height: auto;
		display: block;
		border: 1px solid #2a261e;
		border-radius: 10px;
		background: #151310;
		box-shadow: 0 20px 60px rgb(0 0 0 / 0.45);
	}
	.foot {
		margin-top: 1rem;
		font-size: 0.8rem;
		color: var(--dim);
	}
	.foot a {
		color: var(--gold);
		text-decoration: none;
	}
</style>

<script>
	const canvas = document.getElementById('game');
	const ctx = canvas.getContext('2d');
	const W = canvas.width;
	const H = canvas.height;

	const PADDLE_W = 14;
	const BASE_PADDLE_H = 92;
	const WIDE_PADDLE_H = BASE_PADDLE_H * 1.6;
	const PADDLE_SPEED = 6.2;
	const BALL_R = 20;
	const WIN_SCORE = 7;

	const left = { x: 26, y: H / 2 - BASE_PADDLE_H / 2, h: BASE_PADDLE_H, score: 0, up: false, down: false };
	const right = { x: W - 26 - PADDLE_W, y: H / 2 - BASE_PADDLE_H / 2, h: BASE_PADDLE_H, score: 0, up: false, down: false, ai: true };

	let balls = [];
	let powerups = [];
	let toasts = [];
	let lastTouch = null; // 'left' | 'right' — who the bull last bounced off
	let winner = null;
	let mouseY = null;
	let nextSpawnAt = 0;

	// global ball effects
	const fx = { slowUntil: 0, rageUntil: 0 };
	// per-side effects
	const side = {
		left: { wideUntil: 0, fence: false },
		right: { wideUntil: 0, fence: false },
	};

	const TYPES = {
		horns: { glyph: '♉', color: '#d4a24e', label: 'HORNS' },
		tranq: { glyph: '❄', color: '#7cc4e8', label: 'TRANQ' },
		rage: { glyph: '🔥', color: '#c1483b', label: 'RAGE' },
		herd: { glyph: '🐄', color: '#b08850', label: 'HERD' },
		fence: { glyph: '🚧', color: '#e8c547', label: 'FENCE' },
	};

	function makeBall(dir, extra = false, deadline = 0) {
		const angle = Math.random() * 0.6 - 0.3; // -0.3..0.3 rad
		const speed = 7.4;
		return {
			x: W / 2,
			y: H / 2,
			vx: Math.cos(angle) * speed * dir,
			vy: Math.sin(angle) * speed,
			speed,
			spin: 0,
			rot: 0,
			extra,
			deadline,
		};
	}

	function resetMatch() {
		left.score = 0;
		right.score = 0;
		left.h = BASE_PADDLE_H;
		right.h = BASE_PADDLE_H;
		winner = null;
		balls = [makeBall(Math.random() < 0.5 ? 1 : -1)];
		powerups = [];
		toasts = [];
		lastTouch = null;
		fx.slowUntil = 0;
		fx.rageUntil = 0;
		side.left.wideUntil = 0;
		side.left.fence = false;
		side.right.wideUntil = 0;
		side.right.fence = false;
		nextSpawnAt = performance.now() + 5000;
	}

	function toast(text, color = '#e8e2d6') {
		toasts.push({ text, color, t0: performance.now() });
		if (toasts.length > 4) toasts.shift();
	}

	function clampPaddle(p) {
		p.y = Math.max(8, Math.min(H - p.h - 8, p.y));
	}

	function movePaddle(p) {
		if (p.up) p.y -= PADDLE_SPEED;
		if (p.down) p.y += PADDLE_SPEED;
		clampPaddle(p);
	}

	function aiMove(p) {
		// chase the nearest incoming ball with a little laziness
		const incoming = balls.filter((b) => (p === left ? b.vx < 0 : b.vx > 0));
		const target0 = incoming.length
			? incoming.reduce((a, b) => (Math.abs(b.x - p.x) < Math.abs(a.x - p.x) ? b : a))
			: balls[0];
		if (!target0) return;
		const target = target0.y - p.h / 2 + Math.sin(performance.now() / 500) * 14;
		const delta = target - p.y;
		const step = Math.sign(delta) * Math.min(Math.abs(delta), PADDLE_SPEED * 0.82);
		p.y += step;
		clampPaddle(p);
	}

	function hitPaddle(b, p, dir) {
		const rel = (b.y - (p.y + p.h / 2)) / (p.h / 2); // -1..1
		const angle = rel * 0.9; // max ~51°
		b.speed = Math.min(b.speed * 1.05, 14); // ramp
		b.vx = Math.cos(angle) * b.speed * dir;
		b.vy = Math.sin(angle) * b.speed;
		b.spin = rel * 0.25;
		lastTouch = dir === 1 ? 'left' : 'right';
	}

	function trySpawn(now) {
		const keys = Object.keys(TYPES);
		for (let i = 0; i < 5; i++) {
			const x = W * 0.32 + Math.random() * W * 0.36;
			const y = 70 + Math.random() * (H - 140);
			if (balls.every((b) => Math.hypot(b.x - x, b.y - y) > 110)) {
				const type = keys[(Math.random() * keys.length) | 0];
				powerups.push({ x, y, r: 16, type, ...TYPES[type] });
				nextSpawnAt = now + 8000 + Math.random() * 5000;
				return;
			}
		}
		nextSpawnAt = now + 1500; // crowded — retry soon
	}

	function collect(pu) {
		const now = performance.now();
		const who = lastTouch ?? (Math.random() < 0.5 ? 'left' : 'right');
		const name = who === 'right' ? 'YOU' : 'BULL';
		const s = side[who];
		if (pu.type === 'horns') {
			s.wideUntil = now + 8000;
			toast(`♉ LONG HORNS → ${name}`, pu.color);
		} else if (pu.type === 'tranq') {
			fx.slowUntil = now + 5000;
			fx.rageUntil = 0;
			toast('❄ TRANQ DART — the bull slows down', pu.color);
		} else if (pu.type === 'rage') {
			fx.rageUntil = now + 5000;
			fx.slowUntil = 0;
			toast('🔥 RAGE — the bull is furious', pu.color);
		} else if (pu.type === 'herd') {
			if (!balls.some((b) => b.extra)) {
				const dir = who === 'right' ? -1 : 1; // send it at the opponent
				balls.push(makeBall(dir, true, now + 14000));
				toast(`🐄 HERD — extra bull for ${name}`, pu.color);
			}
		} else if (pu.type === 'fence') {
			s.fence = true;
			toast(`🚧 FENCE → ${name}`, pu.color);
		}
	}

	function score(conceder, b) {
		const scorer = conceder === 'left' ? right : left;
		scorer.score++;
		const idx = balls.indexOf(b);
		if (idx >= 0) balls.splice(idx, 1);
		if (scorer.score >= WIN_SCORE) {
			winner = scorer === right ? 'you' : 'the bull';
			powerups = [];
			return;
		}
		if (!b.extra) balls.unshift(makeBall(conceder === 'left' ? 1 : -1));
	}

	function update() {
		const now = performance.now();
		if (winner) return;

		// wide paddles decay
		left.h = now < side.left.wideUntil ? WIDE_PADDLE_H : BASE_PADDLE_H;
		right.h = now < side.right.wideUntil ? WIDE_PADDLE_H : BASE_PADDLE_H;

		// human (right) + bull AI (left)
		movePaddle(right);
		aiMove(left);
		if (mouseY != null) {
			right.y = mouseY - right.h / 2;
			clampPaddle(right);
		}

		// spawn powerups
		if (now > nextSpawnAt && powerups.length < 2) trySpawn(now);

		const speedMul = now < fx.rageUntil ? 1.35 : now < fx.slowUntil ? 0.55 : 1;

		for (const b of [...balls]) {
			// ease current speed toward target (ramp × powerup multiplier)
			const mag = Math.hypot(b.vx, b.vy) || 1;
			const cur = mag + (b.speed * speedMul - mag) * 0.12;
			b.vx = (b.vx / mag) * cur;
			b.vy = (b.vy / mag) * cur;

			b.x += b.vx;
			b.y += b.vy;

			// walls
			if (b.y - BALL_R < 0) {
				b.y = BALL_R;
				b.vy = Math.abs(b.vy);
			}
			if (b.y + BALL_R > H) {
				b.y = H - BALL_R;
				b.vy = -Math.abs(b.vy);
			}

			// paddles
			for (const [p, dir] of [[left, 1], [right, -1]]) {
				const inX =
					(dir === 1 && b.x - BALL_R < p.x + PADDLE_W && b.x > p.x) ||
					(dir === -1 && b.x + BALL_R > p.x && b.x < p.x + PADDLE_W);
				const inY = b.y + BALL_R > p.y && b.y - BALL_R < p.y + p.h;
				if (inX && inY && Math.sign(b.vx) !== dir) {
					b.x = dir === 1 ? p.x + PADDLE_W + BALL_R : p.x - BALL_R;
					hitPaddle(b, p, dir);
				}
			}

			// powerup pickup
			for (const pu of [...powerups]) {
				if (Math.hypot(b.x - pu.x, b.y - pu.y) < BALL_R + pu.r) {
					powerups.splice(powerups.indexOf(pu), 1);
					collect(pu);
				}
			}

			// goals (fences save once at the edge)
			if (b.vx < 0) {
				if (b.x - BALL_R < 2 && side.left.fence) {
					side.left.fence = false;
					b.x = BALL_R + 2;
					b.vx = Math.abs(b.vx);
					b.vy *= 0.5;
					toast('🚧 FENCE SAVE', '#e8c547');
				} else if (b.x < -40) {
					score('left', b);
					continue;
				}
			} else if (b.vx > 0) {
				if (b.x + BALL_R > W - 2 && side.right.fence) {
					side.right.fence = false;
					b.x = W - BALL_R - 2;
					b.vx = -Math.abs(b.vx);
					b.vy *= 0.5;
					toast('🚧 FENCE SAVE', '#e8c547');
				} else if (b.x > W + 40) {
					score('right', b);
					continue;
				}
			}
		}

		// herd bulls expire
		balls = balls.filter((b) => !b.extra || now < b.deadline);
	}

	function drawBull(x, y, r, rot) {
		ctx.save();
		ctx.translate(x, y);
		ctx.rotate(rot);
		// head
		ctx.fillStyle = '#d4a24e';
		ctx.beginPath();
		ctx.arc(0, 0, r, 0, Math.PI * 2);
		ctx.fill();
		// muzzle
		ctx.fillStyle = '#a87c34';
		ctx.beginPath();
		ctx.ellipse(0, r * 0.35, r * 0.55, r * 0.4, 0, 0, Math.PI * 2);
		ctx.fill();
		// horns
		ctx.strokeStyle = '#e8e2d6';
		ctx.lineWidth = r * 0.22;
		ctx.lineCap = 'round';
		ctx.beginPath();
		ctx.moveTo(-r * 0.55, -r * 0.55);
		ctx.quadraticCurveTo(-r * 1.25, -r * 1.05, -r * 1.5, -r * 0.35);
		ctx.moveTo(r * 0.55, -r * 0.55);
		ctx.quadraticCurveTo(r * 1.25, -r * 1.05, r * 1.5, -r * 0.35);
		ctx.stroke();
		// eyes
		ctx.fillStyle = '#11100e';
		ctx.beginPath();
		ctx.arc(-r * 0.35, -r * 0.1, r * 0.12, 0, Math.PI * 2);
		ctx.arc(r * 0.35, -r * 0.1, r * 0.12, 0, Math.PI * 2);
		ctx.fill();
		// nostrils
		ctx.beginPath();
		ctx.arc(-r * 0.18, r * 0.42, r * 0.07, 0, Math.PI * 2);
		ctx.arc(r * 0.18, r * 0.42, r * 0.07, 0, Math.PI * 2);
		ctx.fill();
		ctx.restore();
	}

	function drawHUD(now) {
		ctx.font = '600 11px ui-monospace, SFMono-Regular, Menlo, monospace';
		ctx.textBaseline = 'top';

		// per-side effects
		for (const [key, x, align] of [['left', 24, 'left'], ['right', W - 24, 'right']]) {
			const s = side[key];
			const parts = [];
			if (now < s.wideUntil) parts.push(`♉ ${((s.wideUntil - now) / 1000).toFixed(0)}s`);
			if (s.fence) parts.push('🚧');
			if (parts.length) {
				ctx.textAlign = align;
				ctx.fillStyle = '#d4a24e';
				ctx.fillText(parts.join('  '), x, 18);
			}
		}

		// global bull mood, under the scores
		const mood = [];
		if (now < fx.slowUntil) mood.push(`❄ ${((fx.slowUntil - now) / 1000).toFixed(0)}s`);
		if (now < fx.rageUntil) mood.push(`🔥 ${((fx.rageUntil - now) / 1000).toFixed(0)}s`);
		if (mood.length) {
			ctx.textAlign = 'center';
			ctx.fillStyle = '#6b665c';
			ctx.fillText(mood.join('  '), W / 2, 74);
		}
		ctx.textBaseline = 'alphabetic';
	}

	function drawToasts(now) {
		ctx.textAlign = 'center';
		ctx.font = '600 13px ui-monospace, SFMono-Regular, Menlo, monospace';
		let i = 0;
		for (const t of toasts) {
			const age = (now - t.t0) / 1400;
			if (age >= 1) continue;
			ctx.globalAlpha = 1 - age;
			ctx.fillStyle = t.color;
			ctx.fillText(t.text, W / 2, H * 0.3 + i * 20 - age * 12);
			i++;
		}
		ctx.globalAlpha = 1;
		toasts = toasts.filter((t) => now - t.t0 < 1400);
	}

	function draw() {
		const now = performance.now();
		ctx.clearRect(0, 0, W, H);

		// center line
		ctx.strokeStyle = '#2a261e';
		ctx.setLineDash([8, 12]);
		ctx.lineWidth = 2;
		ctx.beginPath();
		ctx.moveTo(W / 2, 12);
		ctx.lineTo(W / 2, H - 12);
		ctx.stroke();
		ctx.setLineDash([]);

		// fences
		for (const [key, x] of [['left', 10], ['right', W - 10]]) {
			if (side[key].fence) {
				ctx.strokeStyle = '#e8c547';
				ctx.globalAlpha = 0.65 + Math.sin(now / 200) * 0.2;
				ctx.setLineDash([6, 8]);
				ctx.lineWidth = 3;
				ctx.beginPath();
				ctx.moveTo(x, 8);
				ctx.lineTo(x, H - 8);
				ctx.stroke();
				ctx.setLineDash([]);
				ctx.globalAlpha = 1;
			}
		}

		// paddles (wide ones glow gold)
		ctx.fillStyle = '#c1483b';
		if (left.h > BASE_PADDLE_H) {
			ctx.shadowColor = '#d4a24e';
			ctx.shadowBlur = 14;
		}
		ctx.fillRect(left.x, left.y, PADDLE_W, left.h);
		ctx.shadowBlur = 0;
		ctx.fillStyle = '#e8e2d6';
		if (right.h > BASE_PADDLE_H) {
			ctx.shadowColor = '#d4a24e';
			ctx.shadowBlur = 14;
		}
		ctx.fillRect(right.x, right.y, PADDLE_W, right.h);
		ctx.shadowBlur = 0;

		// powerups
		for (const p of powerups) {
			const pulse = 1 + Math.sin(now / 280 + p.x) * 0.08;
			ctx.save();
			ctx.globalAlpha = 0.9;
			ctx.fillStyle = '#151310';
			ctx.strokeStyle = p.color;
			ctx.lineWidth = 2;
			ctx.beginPath();
			ctx.arc(p.x, p.y, p.r * pulse, 0, Math.PI * 2);
			ctx.fill();
			ctx.stroke();
			ctx.font = '15px serif';
			ctx.textAlign = 'center';
			ctx.textBaseline = 'middle';
			ctx.fillStyle = p.color;
			ctx.fillText(p.glyph, p.x, p.y + 1);
			ctx.font = '600 7px ui-monospace, monospace';
			ctx.fillStyle = '#776d62';
			ctx.fillText(p.label, p.x, p.y + p.r + 10);
			ctx.restore();
		}

		// bulls
		for (const b of balls) {
			b.rot += 0.03 + b.spin;
			drawBull(b.x, b.y, BALL_R, b.rot);
		}

		// scores
		ctx.fillStyle = '#6b665c';
		ctx.font = '700 44px Inter, system-ui, sans-serif';
		ctx.textAlign = 'center';
		ctx.fillText(left.score, W / 2 - 60, 56);
		ctx.fillText(right.score, W / 2 + 60, 56);

		drawHUD(now);
		drawToasts(now);

		if (winner) {
			ctx.fillStyle = 'rgb(17 16 14 / 0.82)';
			ctx.fillRect(0, 0, W, H);
			ctx.fillStyle = '#d4a24e';
			ctx.font = '700 40px Inter, system-ui, sans-serif';
			ctx.fillText(winner === 'you' ? 'you win 🏆' : `${winner} wins`, W / 2, H / 2 - 8);
			ctx.fillStyle = '#e8e2d6';
			ctx.font = '400 16px Inter, system-ui, sans-serif';
			ctx.fillText('click or press R to run it back', W / 2, H / 2 + 28);
		}
	}

	function loop() {
		update();
		draw();
		requestAnimationFrame(loop);
	}

	// input
	canvas.addEventListener('mousemove', (e) => {
		const rect = canvas.getBoundingClientRect();
		mouseY = ((e.clientY - rect.top) / rect.height) * H;
	});
	canvas.addEventListener('mouseleave', () => (mouseY = null));
	canvas.addEventListener('touchmove', (e) => {
		e.preventDefault();
		const rect = canvas.getBoundingClientRect();
		mouseY = ((e.touches[0].clientY - rect.top) / rect.height) * H;
	}, { passive: false });
	canvas.addEventListener('click', () => winner && resetMatch());

	addEventListener('keydown', (e) => {
		const human = right;
		if (['ArrowUp', 'w', 'W'].includes(e.key)) human.up = true;
		if (['ArrowDown', 's', 'S'].includes(e.key)) human.down = true;
		if (e.key === 'r' || e.key === 'R') resetMatch();
		if (e.key === ' ') e.preventDefault();
	});
	addEventListener('keyup', (e) => {
		const human = right;
		if (['ArrowUp', 'w', 'W'].includes(e.key)) human.up = false;
		if (['ArrowDown', 's', 'S'].includes(e.key)) human.down = false;
	});

	resetMatch();
	loop();
</script>
