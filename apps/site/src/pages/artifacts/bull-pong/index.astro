---
import ElToroLogo from '../../../components/ElToroLogo.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
		<title>Bull Pong — El Toro</title>
	</head>
	<body>
		<main>
			<ElToroLogo size={64} class="pong-logo" />
			<h1>🐂 bull pong</h1>
			<p class="hint" id="hint">
				mouse / W·S / ↑·↓ to move · first to 7 · the bull is the ball<br />
				powerups drop mid-field — the bull collects them for whoever touched it last
			</p>

			<div class="lobby">
				<button class="btn" id="btn-ai" type="button">🤖 vs the bull</button>
				<button class="btn" id="btn-host" type="button">🔗 host a game</button>
				<form class="join" id="join-form">
					<input
						class="code"
						id="join-code"
						name="room"
						maxlength="10"
						autocomplete="off"
						autocapitalize="characters"
						spellcheck="false"
						placeholder="room code"
						aria-label="Room code"
					/>
					<button class="btn" type="submit">🎟 join</button>
				</form>
			</div>
			<p class="net" id="net" role="status" aria-live="polite">
				solo mode — play the bull, or host a game to play a friend
			</p>

			<canvas id="game" width="900" height="560"></canvas>
			<p class="foot">
				<a href="/">← El Toro HQ</a> · an artifact by the resident agent · netplay via the
				<a href="https://github.com/yjs/y-websocket">y-websocket</a> relay
			</p>
		</main>
	</body>
</html>

<style>
	:root {
		color-scheme: dark;
		--bg: #11100e;
		--ink: #e8e2d6;
		--gold: #d4a24e;
		--red: #c1483b;
		--dim: #6b665c;
	}
	* {
		box-sizing: border-box;
		margin: 0;
	}
	body {
		background:
			radial-gradient(1200px 500px at 50% -10%, #1c1913, transparent),
			var(--bg);
		color: var(--ink);
		font-family: Inter, ui-sans-serif, system-ui, sans-serif;
		min-height: 100vh;
		display: grid;
		place-items: center;
		padding: 1rem;
	}
	main {
		text-align: center;
		width: min(920px, 96vw);
	}
	.pong-logo {
		margin: 0 auto 1.25rem;
	}
	h1 {
		font-size: 1.6rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin-bottom: 0.4rem;
	}
	.hint {
		color: var(--dim);
		font-size: 0.85rem;
		line-height: 1.5;
		margin-bottom: 1rem;
	}
	.lobby {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: center;
		align-items: center;
		margin-bottom: 0.6rem;
	}
	.btn {
		padding: 0.5rem 0.85rem;
		border: 1px solid #3b332b;
		border-radius: 8px;
		background: #1b1813;
		color: var(--ink);
		font: 600 0.8rem/1 inherit;
		cursor: pointer;
	}
	.btn:hover {
		border-color: var(--gold);
		color: #fff;
	}
	.btn.on {
		border-color: var(--gold);
		background: #2a2318;
		color: var(--gold);
	}
	.join {
		display: flex;
		gap: 0.35rem;
	}
	.code {
		width: 7.5rem;
		padding: 0.5rem 0.6rem;
		border: 1px solid #3b332b;
		border-radius: 8px;
		background: #151310;
		color: var(--ink);
		font: 600 0.8rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
		text-transform: uppercase;
		letter-spacing: 0.12em;
	}
	.code:focus-visible,
	.btn:focus-visible {
		outline: 2px solid var(--gold);
		outline-offset: 1px;
	}
	.net {
		min-height: 1.2rem;
		font: 500 0.78rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
		color: var(--dim);
		margin-bottom: 0.55rem;
		overflow-wrap: anywhere;
	}
	.net[data-kind='good'] {
		color: var(--gold);
	}
	.net[data-kind='bad'] {
		color: var(--red);
	}
	canvas {
		width: 100%;
		height: auto;
		display: block;
		border: 1px solid #2a261e;
		border-radius: 10px;
		background: #151310;
		box-shadow: 0 20px 60px rgb(0 0 0 / 0.45);
	}
	.foot {
		margin-top: 1rem;
		font-size: 0.8rem;
		color: var(--dim);
	}
	.foot a {
		color: var(--gold);
		text-decoration: none;
	}
</style>

<script>
	import * as Y from 'yjs';
	import { WebsocketProvider } from 'y-websocket';
	import {
		W,
		H,
		PEN,
		PADDLE_W,
		BASE_PADDLE_H,
		BALL_R,
		PADDLE_SPEED,
		FRAME_MS,
		createState,
		resetMatch,
		step,
		serialize,
		deserialize,
		toast,
	} from '../../../lib/bull-pong/engine.js';
	import {
		RELAY_URL,
		makeCode,
		normalizeCode,
		roomName,
		shareLink,
		codeFromUrl,
		resolveRoom,
		acceptSnapshot,
		describeRoom,
	} from '../../../lib/bull-pong/netcode.js';

	const canvas = document.getElementById('game');
	const ctx = canvas.getContext('2d');
	const netEl = document.getElementById('net');
	const hintEl = document.getElementById('hint');
	const btnAi = document.getElementById('btn-ai');
	const btnHost = document.getElementById('btn-host');
	const joinForm = document.getElementById('join-form');
	const codeInput = document.getElementById('join-code');

	const bullImg = new Image();
	bullImg.src = '/artifacts/bull-pong/bull-ball.png';

	// ---------------------------------------------------------------- state ----

	/** 'ai' = single player, 'host' = authoritative multiplayer, 'guest' = remote view */
	let mode = 'ai';
	const game = createState((Math.random() * 1e9) | 0); // ai/host simulation
	let view = game; // what the renderer draws
	let target = null; // guest: latest host snapshot (extrapolated against snapAt)
	let snapAt = 0; // guest: when that snapshot landed

	let localY = H / 2; // local player's paddle centre
	let room = null; // player-facing room code
	let link = null; // { doc, provider, awareness }
	let relayUp = null;
	let picture = null; // who is who, per the awareness states
	let seenSeq = -1; // guest: last host snapshot sequence applied
	let lastResetReq = 0; // host: last reset request counter seen
	let resetCounter = 0; // guest: our own reset request counter
	let matchLive = false; // host: a match with the current guest is running
	let lastGuestSignal = 0; // host: last awareness update from the seated guest
	let lastHostSignal = 0; // guest: last snapshot from the host
	let lastSent = 0;
	let lastSnapshot = 0;
	let acc = 0;
	let lastFrame = 0;

	function setStatus(text, kind = '') {
		netEl.textContent = text;
		if (kind) netEl.dataset.kind = kind;
		else delete netEl.dataset.kind;
	}

	function refreshStatus(kind) {
		const link = room ? shareLink(location.origin, room) : null;
		setStatus(
			describeRoom({ mode, room, picture, relayUp, link }),
			kind ?? (picture && !picture.waiting && mode !== 'ai' ? 'good' : ''),
		);
	}

	function markMode() {
		btnAi.classList.toggle('on', mode === 'ai');
		btnHost.classList.toggle('on', mode === 'host');
		if (mode === 'guest') {
			hintEl.innerHTML =
				'you are the <strong>left</strong> bull · mouse / W·S / ↑·↓ to move · first to 7<br />the host runs the match — the bull obeys whoever touched it last';
		} else if (mode === 'host') {
			hintEl.innerHTML =
				'you are the <strong>right</strong> bull · mouse / W·S / ↑·↓ to move · first to 7<br />you run the match — share your room code so a friend can join';
		} else {
			hintEl.innerHTML =
				'mouse / W·S / ↑·↓ to move · first to 7 · the bull is the ball<br />powerups drop mid-field — the bull collects them for whoever touched it last';
		}
	}

	// ------------------------------------------------------------------ draw ----

	function drawBull(x, y, r, rot) {
		ctx.save();
		ctx.translate(x, y);
		ctx.rotate(rot);
		if (bullImg.complete && bullImg.naturalWidth) {
			const s = r * 2.35; // sprite has transparent padding; draw a touch larger
			ctx.drawImage(bullImg, -s / 2, -s / 2, s, s);
		} else {
			ctx.fillStyle = '#d4a24e';
			ctx.beginPath();
			ctx.arc(0, 0, r, 0, Math.PI * 2);
			ctx.fill();
		}
		ctx.restore();
	}

	function drawHUD(s, now) {
		ctx.font = '600 11px ui-monospace, SFMono-Regular, Menlo, monospace';
		ctx.textBaseline = 'top';

		for (const [key, x, align] of [
			['left', 24, 'left'],
			['right', W - 24, 'right'],
		]) {
			const sd = s.side[key];
			const parts = [];
			if (now < sd.wideUntil) parts.push(`♉ ${((sd.wideUntil - now) / 1000).toFixed(0)}s`);
			if (sd.fence) parts.push('🚧');
			if (parts.length) {
				ctx.textAlign = align;
				ctx.fillStyle = '#d4a24e';
				ctx.fillText(parts.join('  '), x, 18);
			}
		}

		const mood = [];
		if (now < s.fx.slowUntil) mood.push(`❄ ${((s.fx.slowUntil - now) / 1000).toFixed(0)}s`);
		if (now < s.fx.rageUntil) mood.push(`🔥 ${((s.fx.rageUntil - now) / 1000).toFixed(0)}s`);
		if (mood.length) {
			ctx.textAlign = 'center';
			ctx.fillStyle = '#6b665c';
			ctx.fillText(mood.join('  '), W / 2, 74);
		}
		ctx.textBaseline = 'alphabetic';
	}

	function drawToasts(s, now) {
		ctx.textAlign = 'center';
		ctx.font = '600 13px ui-monospace, SFMono-Regular, Menlo, monospace';
		let i = 0;
		for (const t of s.toasts) {
			const age = (now - t.t0) / 1400;
			if (age >= 1) continue;
			ctx.globalAlpha = 1 - age;
			ctx.fillStyle = t.color;
			ctx.fillText(t.text, W / 2, H * 0.3 + i * 20 - age * 12);
			i++;
		}
		ctx.globalAlpha = 1;
	}

	function draw() {
		const s = view;
		const now = s.now;
		ctx.clearRect(0, 0, W, H);

		// center line
		ctx.strokeStyle = '#2a261e';
		ctx.setLineDash([8, 12]);
		ctx.lineWidth = 2;
		ctx.beginPath();
		ctx.moveTo(W / 2, 12);
		ctx.lineTo(W / 2, H - 12);
		ctx.stroke();
		ctx.setLineDash([]);

		// bull-pen rails (posts + double rails, gates at the goals)
		const RAIL = '#8a6a42';
		const RAIL_HI = '#b89363';
		ctx.lineCap = 'butt';
		for (const y of [6, 16, H - 16, H - 6]) {
			ctx.strokeStyle = RAIL;
			ctx.lineWidth = 4;
			ctx.beginPath();
			ctx.moveTo(0, y);
			ctx.lineTo(W, y);
			ctx.stroke();
			ctx.strokeStyle = RAIL_HI;
			ctx.lineWidth = 1;
			ctx.beginPath();
			ctx.moveTo(0, y - 1.5);
			ctx.lineTo(W, y - 1.5);
			ctx.stroke();
		}
		for (const x of [6, 16, W - 16, W - 6]) {
			ctx.strokeStyle = RAIL;
			ctx.lineWidth = 4;
			ctx.beginPath();
			ctx.moveTo(x, 0);
			ctx.lineTo(x, H);
			ctx.stroke();
			ctx.strokeStyle = RAIL_HI;
			ctx.lineWidth = 1;
			ctx.beginPath();
			ctx.moveTo(x - 1.5, 0);
			ctx.lineTo(x - 1.5, H);
			ctx.stroke();
		}
		ctx.fillStyle = '#6e5433';
		for (const x of [6, W / 2, W - 6]) for (const y of [6, H - 6]) ctx.fillRect(x - 3, y - 3, 6, 6);
		for (const x of [6, 16, W - 16, W - 6])
			for (const y of [H / 4, H / 2, (H * 3) / 4]) ctx.fillRect(x - 3, y - 3, 6, 6);

		// fences
		for (const [key, x] of [
			['left', 24],
			['right', W - 24],
		]) {
			if (s.side[key].fence) {
				ctx.strokeStyle = '#e8c547';
				ctx.globalAlpha = 0.65 + Math.sin(now / 200) * 0.2;
				ctx.setLineDash([6, 8]);
				ctx.lineWidth = 3;
				ctx.beginPath();
				ctx.moveTo(x, 8);
				ctx.lineTo(x, H - 8);
				ctx.stroke();
				ctx.setLineDash([]);
				ctx.globalAlpha = 1;
			}
		}

		// paddles (wide ones glow gold)
		ctx.fillStyle = '#c1483b';
		if (s.left.h > BASE_PADDLE_H) {
			ctx.shadowColor = '#d4a24e';
			ctx.shadowBlur = 14;
		}
		ctx.fillRect(s.left.x, s.left.y, PADDLE_W, s.left.h);
		ctx.shadowBlur = 0;
		ctx.fillStyle = '#e8e2d6';
		if (s.right.h > BASE_PADDLE_H) {
			ctx.shadowColor = '#d4a24e';
			ctx.shadowBlur = 14;
		}
		ctx.fillRect(s.right.x, s.right.y, PADDLE_W, s.right.h);
		ctx.shadowBlur = 0;

		// powerups
		for (const p of s.powerups) {
			const pulse = 1 + Math.sin(now / 280 + p.x) * 0.08;
			ctx.save();
			ctx.globalAlpha = 0.9;
			ctx.fillStyle = '#151310';
			ctx.strokeStyle = p.color;
			ctx.lineWidth = 2;
			ctx.beginPath();
			ctx.arc(p.x, p.y, p.r * pulse, 0, Math.PI * 2);
			ctx.fill();
			ctx.stroke();
			ctx.font = '15px serif';
			ctx.textAlign = 'center';
			ctx.textBaseline = 'middle';
			ctx.fillStyle = p.color;
			ctx.fillText(p.glyph, p.x, p.y + 1);
			ctx.font = '600 7px ui-monospace, monospace';
			ctx.fillStyle = '#776d62';
			ctx.fillText(p.label, p.x, p.y + p.r + 10);
			ctx.restore();
		}

		// bulls
		for (const b of s.balls) drawBull(b.x, b.y, BALL_R, b.rot);

		// scores
		ctx.fillStyle = '#6b665c';
		ctx.font = '700 44px Inter, system-ui, sans-serif';
		ctx.textAlign = 'center';
		ctx.fillText(s.left.score, W / 2 - 60, 56);
		ctx.fillText(s.right.score, W / 2 + 60, 56);

		drawHUD(s, now);
		drawToasts(s, now);

		if (mode !== 'ai') {
			ctx.font = '600 10px ui-monospace, SFMono-Regular, Menlo, monospace';
			ctx.fillStyle = '#6e5433';
			ctx.textAlign = 'left';
			ctx.fillText(mode === 'guest' ? 'GUEST' : 'HOST', 24, H - 12);
			ctx.textAlign = 'right';
			ctx.fillText(mode === 'guest' ? 'HOST' : 'GUEST', W - 24, H - 12);
		}

		if (s.winner) {
			ctx.fillStyle = 'rgb(17 16 14 / 0.82)';
			ctx.fillRect(0, 0, W, H);
			ctx.fillStyle = '#d4a24e';
			ctx.font = '700 40px Inter, system-ui, sans-serif';
			ctx.textAlign = 'center';
			const who = s.winner === 'right' ? 'right bull' : 'left bull';
			ctx.fillText(
				mode === 'ai' ? (s.winner === 'right' ? 'you win 🏆' : 'the bull wins') : `${who} wins 🏆`,
				W / 2,
				H / 2 - 8,
			);
			ctx.fillStyle = '#e8e2d6';
			ctx.font = '400 16px Inter, system-ui, sans-serif';
			ctx.fillText('click or press R to run it back', W / 2, H / 2 + 28);
		}
	}

	// -------------------------------------------------------------- netplay ----

	function teardownLink() {
		if (!link) return;
		try {
			link.provider.destroy();
			link.doc.destroy();
		} catch {
			/* already gone */
		}
		link = null;
		relayUp = false;
		picture = null;
	}

	function connect(code, intent) {
		teardownLink();
		room = code;
		mode = intent;
		seenSeq = -1;
		lastResetReq = 0;
		matchLive = false;
		markMode();

		const doc = new Y.Doc();
		const provider = new WebsocketProvider(RELAY_URL, roomName(code), doc);
		link = { doc, provider, awareness: provider.awareness };
		provider.awareness.setLocalState({ r: intent });
		provider.on('status', (event) => {
			relayUp = event.status === 'connected' ? true : event.status === 'connecting' ? null : false;
			syncPeers();
		});
		provider.on('connection-error', () => {
			relayUp = false;
			syncPeers();
		});
		provider.awareness.on('change', syncPeers);
		provider.awareness.on('update', (changes) => {
			const now = performance.now();
			if (mode === 'host' && picture?.guestId != null) {
				const fromGuest = [...(changes?.added ?? []), ...(changes?.updated ?? [])];
				if (fromGuest.includes(picture.guestId)) lastGuestSignal = now;
			}
			syncPeers();
		});

		resetMatch(game);
		view = game;
		setStatus(describeRoom({ mode, room, picture: null, relayUp: null }));
	}

	function applySnapshot(snap) {
		const now = performance.now();
		const next = deserialize(snap, now);
		if (!target || target.balls.length !== next.balls.length) view = next;
		target = next;
		snapAt = now;
		lastHostSignal = now;
		view.now = now;
		view.left.score = next.left.score;
		view.right.score = next.right.score;
		view.left.h = next.left.h;
		view.right.h = next.right.h;
		view.powerups = next.powerups;
		view.fx = next.fx;
		view.side = next.side;
		view.toasts = next.toasts;
		view.winner = next.winner;
		view.right.y = next.right.y;
		view.balls = view.balls.length === next.balls.length ? view.balls : next.balls;
		view.balls.forEach((b, i) => {
			b.rot = next.balls[i].rot;
			b.extra = next.balls[i].extra;
		});
		seenSeq = snap.n ?? seenSeq;
	}

	/** Re-read the room from the awareness states and react to changes. */
	function syncPeers() {
		if (!link) return;
		const states = link.awareness.getStates();
		const before = picture;
		picture = resolveRoom(states, link.awareness.clientID);
		peerHere = mode === 'host' ? picture.guestId != null : picture.hostId != null;

		if (mode === 'host') {
			// start a match when a guest arrives; drop it when they leave
			if (picture.guestId != null && !matchLive) {
				matchLive = true;
				lastGuestSignal = performance.now();
				resetMatch(game);
				view = game;
				localY = H / 2;
				toast(game, '🤝 OPPONENT IN THE PEN', '#d4a24e');
				publish(true);
			} else if (picture.guestId == null && matchLive) {
				matchLive = false;
			}
			// clamp the guest's paddle straight from their last input
			const guestState = picture.guestId != null ? states.get(picture.guestId) : null;
			const guestY = Number(guestState?.i?.y);
			if (Number.isFinite(guestY)) {
				game.left.touchY = Math.max(PEN, Math.min(H - PEN, guestY));
			}
			// guest asked for a rematch
			const req = Number(guestState?.q) || 0;
			if (req > lastResetReq) {
				lastResetReq = req;
				resetMatch(game);
				toast(game, '🔄 REMATCH', '#d4a24e');
				publish(true);
			}
		} else if (mode === 'guest') {
			const hostState = picture.hostId != null ? states.get(picture.hostId) : null;
			if (acceptSnapshot(hostState, 'guest', seenSeq)) {
				applySnapshot(hostState.s);
				if (before?.waiting !== false && picture.waiting === false) {
					setStatus('', 'good');
				}
			}
		}

		const wasWaiting = before ? before.waiting : true;
		refreshStatus();
		if (wasWaiting !== picture.waiting && !picture.waiting && mode === 'guest') {
			/* status text already covers it */
		}
	}

	function publish(force = false) {
		if (!link) return;
		const now = performance.now();
		if (!force && now - lastSnapshot < 40) return;
		lastSnapshot = now;
		link.awareness.setLocalStateField('s', serialize(game));
	}

	function publishInput() {
		if (!link || mode !== 'guest') return;
		const now = performance.now();
		if (now - lastSent < 33) return;
		lastSent = now;
		link.awareness.setLocalStateField('i', { y: Math.round(localY) });
	}

	function requestRematch() {
		if (mode === 'host') {
			resetMatch(game);
			publish(true);
			toast(game, '🔄 REMATCH', '#d4a24e');
		} else if (mode === 'guest' && link) {
			resetCounter++;
			link.awareness.setLocalStateField('q', resetCounter);
		} else {
			resetMatch(game);
		}
	}

	function backToSolo(reason) {
		teardownLink();
		mode = 'ai';
		peerHere = false;
		matchLive = false;
		room = null;
		view = game;
		resetMatch(game);
		markMode();
		setStatus(reason);
	}

	let peerHere = false; // kept for the debug hook

	// ------------------------------------------------------------------ loop ----

	function stepAndSend(now) {
		const dt = lastFrame ? now - lastFrame : FRAME_MS;
		if (mode === 'guest') {
			if (target) {
				view.now = now;
				// extrapolate from the last snapshot with the bull's own velocity,
				// so the guest sees the bull where the host has it now (not 80ms ago)
				const elapsedFrames = Math.min(now - snapAt, 200) / FRAME_MS;
				view.balls.forEach((b, i) => {
					const t = target.balls[i];
					if (!t) return;
					const px = t.x + t.vx * elapsedFrames;
					const py = t.y + t.vy * elapsedFrames;
					b.x += (px - b.x) * 0.5;
					b.y += (py - b.y) * 0.5;
				});
				view.right.y += (target.right.y - view.right.y) * 0.5;
			}
			// your own paddle answers instantly, the host follows your reports
			view.left.y = Math.max(PEN, Math.min(H - view.left.h - PEN, localY - view.left.h / 2));
			publishInput();
			return;
		}

		acc = Math.min(acc + dt, 200);
		let n = 0;
		while (acc >= FRAME_MS && n < 6) {
			step(game, { ai: mode === 'ai' ? 'left' : 'none' });
			acc -= FRAME_MS;
			n++;
		}
		view = game;
		if (mode === 'host' && matchLive) publish();
	}

	function loop(now) {
		stepAndSend(now);
		draw();
		lastFrame = now;
		requestAnimationFrame(loop);
	}

	// ----------------------------------------------------------------- input ----

	function pointerY(clientY) {
		const rect = canvas.getBoundingClientRect();
		return ((clientY - rect.top) / rect.height) * H;
	}

	function aimLocal(y) {
		localY = Math.max(PEN, Math.min(H - PEN, y));
		if (mode !== 'guest') game.right.touchY = localY;
	}

	canvas.addEventListener('mousemove', (e) => aimLocal(pointerY(e.clientY)));
	canvas.addEventListener(
		'touchmove',
		(e) => {
			e.preventDefault();
			aimLocal(pointerY(e.touches[0].clientY));
		},
		{ passive: false },
	);
	canvas.addEventListener('click', () => {
		if (view.winner) requestRematch();
	});

	addEventListener('keydown', (e) => {
		if (document.activeElement === codeInput) return;
		const key = e.key.toLowerCase();
		if (key === 'arrowup' || key === 'w') {
			aimLocal(localY - PADDLE_SPEED);
			e.preventDefault();
		}
		if (key === 'arrowdown' || key === 's') {
			aimLocal(localY + PADDLE_SPEED);
			e.preventDefault();
		}
		if (key === 'r') requestRematch();
		if (e.key === ' ') e.preventDefault();
	});

	// ---------------------------------------------------------------- lobby ----

	btnAi.addEventListener('click', (e) => {
		e.target.blur();
		backToSolo('solo mode — play the bull, or host a game to play a friend');
	});

	btnHost.addEventListener('click', (e) => {
		e.target.blur();
		const code = makeCode();
		codeInput.value = code;
		connect(code, 'host');
		refreshStatus();
	});

	joinForm.addEventListener('submit', (e) => {
		e.preventDefault();
		e.target.querySelector('button')?.blur();
		const code = normalizeCode(codeInput.value);
		if (!code) {
			setStatus('room codes are 4+ letters/numbers', 'bad');
			return;
		}
		connect(code, 'guest');
		refreshStatus();
	});

	addEventListener('beforeunload', () => teardownLink());

	// -------------------------------------------------------------- debug hook ----

	window.__bullpong = {
		get mode() {
			return mode;
		},
		get room() {
			return room;
		},
		get relayUp() {
			return relayUp;
		},
		get peers() {
			return link ? link.awareness.getStates().size : 0;
		},
		get peerStates() {
			return link
				? [...link.awareness.getStates()].map(([id, s]) => ({ id, r: s?.r, i: s?.i, q: s?.q, hasSnapshot: !!s?.s }))
				: [];
		},
		get status() {
			return netEl.textContent;
		},
		get scores() {
			return { left: view.left.score, right: view.right.score };
		},
		get winner() {
			return view.winner;
		},
		get seq() {
			return seenSeq;
		},
		get snapshot() {
			return {
				left: { y: view.left.y, h: view.left.h, score: view.left.score },
				right: { y: view.right.y, h: view.right.h, score: view.right.score },
				balls: view.balls.map((b) => ({ x: Math.round(b.x), y: Math.round(b.y) })),
				winner: view.winner,
			};
		},
		get netDebug() {
			return {
				snapshotAgeMs: snapAt ? Math.round(performance.now() - snapAt) : null,
				targetBall: target?.balls?.[0] ? { x: target.balls[0].x, y: target.balls[0].y, vx: target.balls[0].vx } : null,
				viewBall: view.balls[0] ? { x: Math.round(view.balls[0].x), y: Math.round(view.balls[0].y) } : null,
			};
		},
		connect,
		backToSolo,
	};

	// ?room=CODE in a share link drops you straight into the room
	const urlCode = codeFromUrl(location.href);
	markMode();
	resetMatch(game);
	localY = H / 2;
	if (urlCode) {
		codeInput.value = urlCode;
		connect(urlCode, 'guest');
		refreshStatus();
	} else {
		setStatus('solo mode — play the bull, or host a game to play a friend');
	}
	requestAnimationFrame(loop);

	// A player who stops talking for 4s has gone: the awareness protocol's own
	// timeout is 30s, far too long to keep a seat warm mid-match.
	setInterval(() => {
		const now = performance.now();
		if (mode === 'host' && matchLive && now - lastGuestSignal > 4000) {
			matchLive = false;
			if (picture) picture = { ...picture, guestId: null, waiting: true };
			refreshStatus('bad');
		} else if (mode === 'guest' && peerHere && now - lastHostSignal > 4000) {
			setStatus('the host went quiet — waiting for them to come back…', 'bad');
		}
	}, 1000);
</script>