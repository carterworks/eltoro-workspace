---
interface Props {
	size?: number;
	class?: string;
}
const { size = 44, class: className } = Astro.props;
---

<svg
	class:list={['el-toro-logo', className]}
	width={size}
	height={size}
	viewBox="0 0 96 96"
	fill="none"
	xmlns="http://www.w3.org/2000/svg"
	role="img"
	aria-label="El Toro logo"
>
	<defs>
		<linearGradient id="et-sun" x1="48" y1="8" x2="48" y2="76" gradientUnits="userSpaceOnUse">
			<stop offset="0" stop-color="#ffd319" />
			<stop offset="0.55" stop-color="#ff901f" />
			<stop offset="1" stop-color="#ff2975" />
		</linearGradient>
		<linearGradient id="et-horns" x1="48" y1="4" x2="48" y2="60" gradientUnits="userSpaceOnUse">
			<stop offset="0" stop-color="#08fdfd" />
			<stop offset="1" stop-color="#08fdfd" stop-opacity="0.35" />
		</linearGradient>
		<pattern id="et-grid" width="12" height="12" patternUnits="userSpaceOnUse" patternTransform="skewX(-32)">
			<path d="M0 0.5H12" stroke="#b967ff" stroke-width="1" />
		</pattern>
		<clipPath id="et-disc"><circle cx="48" cy="42" r="34" /></clipPath>
	</defs>

	<!-- retro sun with scanline gaps -->
	<g clip-path="url(#et-disc)">
		<rect x="14" y="8" width="68" height="26" fill="url(#et-sun)" />
		<rect x="14" y="36" width="68" height="4" fill="url(#et-sun)" />
		<rect x="14" y="42.5" width="68" height="3.5" fill="url(#et-sun)" />
		<rect x="14" y="48.5" width="68" height="3" fill="url(#et-sun)" />
		<rect x="14" y="54" width="68" height="2.5" fill="url(#et-sun)" />
		<rect x="14" y="59" width="68" height="2" fill="url(#et-sun)" />
		<rect x="14" y="63.5" width="68" height="1.5" fill="url(#et-sun)" />
	</g>

	<!-- bull horns: chrome cyan arc over the sun -->
	<path
		d="M48 58 C 37 58 30 52 27 44 C 25 37 26 29 30 22 C 31.5 19.5 32.5 16 32.5 12 L 36 12 C 36 17 35 21 33.5 24.5 C 30.5 31 30 37.5 32 43.5 C 34.5 50 40 54 48 54 C 56 54 61.5 50 64 43.5 C 66 37.5 65.5 31 62.5 24.5 C 61 21 60 17 60 12 L 63.5 12 C 63.5 16 64.5 19.5 66 22 C 70 29 71 37 69 44 C 66 52 59 58 48 58 Z"
		fill="url(#et-horns)"
	/>
	<circle cx="34.2" cy="11" r="2.2" fill="#08fdfd" />
	<circle cx="61.8" cy="11" r="2.2" fill="#08fdfd" />

	<!-- perspective grid floor -->
	<rect x="10" y="76" width="76" height="14" fill="url(#et-grid)" />
	<path d="M10 76H86" stroke="#ff71ce" stroke-width="2" />

	<!-- orbiting spark -->
	<circle class="et-spark" cx="76" cy="30" r="2.4" fill="#fffb96" />
</svg>

<style>
	.el-toro-logo {
		display: block;
		filter: drop-shadow(0 0 10px rgb(255 41 117 / 45%)) drop-shadow(0 0 18px rgb(8 253 253 / 25%));
	}
	.et-spark {
		animation: et-orbit 7s linear infinite;
		transform-origin: 48px 42px;
	}
	@keyframes et-orbit {
		to {
			transform: rotate(360deg);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.et-spark {
			animation: none;
		}
	}
</style>
